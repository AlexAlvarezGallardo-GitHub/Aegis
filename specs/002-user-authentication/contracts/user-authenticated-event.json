{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserAuthenticatedEvent",
  "description": "Published when a user attempts authentication (success or failure)",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event identifier (UUID v7)"
    },
    "eventType": {
      "type": "string",
      "enum": ["USER_AUTHENTICATED"],
      "description": "Domain event type"
    },
    "userId": {
      "type": "string",
      "format": "uuid",
      "description": "The user attempting authentication"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "The user's email address"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the authentication attempt occurred (ISO 8601 UTC)"
    },
    "success": {
      "type": "boolean",
      "description": "Whether the authentication was successful"
    },
    "failureReason": {
      "type": ["string", "null"],
      "description": "Reason for failure if success is false (null if success is true)",
      "enum": [null, "INVALID_CREDENTIALS", "ACCOUNT_LOCKED", "ACCOUNT_SUSPENDED"]
    },
    "correlationId": {
      "type": "string",
      "description": "Correlation ID for request tracing"
    }
  },
  "required": ["eventId", "eventType", "userId", "email", "timestamp", "success", "correlationId"]
}
