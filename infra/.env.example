# ============================================================================
# Aegis — Environment Variables
# ============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit the .env file — it is already in .gitignore.
#
# The values below are DEVELOPMENT-ONLY placeholders. In any shared or
# production environment, generate strong random secrets and inject them via
# your secret store (Docker secrets, K8s Secrets, Vault, CI/CD secrets).
# ============================================================================

# ── PostgreSQL ──────────────────────────────────────────────
# Password for all PostgreSQL instances (identity, wallet, reporting, audit, fraud, payment).
# Used as POSTGRES_PASSWORD in docker-compose.yml.
POSTGRES_PASSWORD=aegis_secret

# ── Spring Boot Datasource ──────────────────────────────────
# Password used by Spring Boot services to connect to PostgreSQL.
# Used as SPRING_DATASOURCE_PASSWORD in docker-compose.yml and by the
# services via ${SPRING_DATASOURCE_PASSWORD} in application.yml.
SPRING_DATASOURCE_PASSWORD=aegis_secret

# ── JWT ─────────────────────────────────────────────────────
# HMAC-SHA256 signing secret used by the Identity and BFF services.
# Must be at least 256 bits (32+ chars). Rotate it per environment.
JWT_SECRET=aegis-dev-secret-key-that-is-at-least-256-bits-long-for-hs256-algorithm

# ── DbGate Admin UI ─────────────────────────────────────────
# Per-database passwords for the DbGate admin tool.
# Each database can have its own password; defaults match POSTGRES_PASSWORD.
DBGATE_PASSWORD_IDENTITY=aegis_secret
DBGATE_PASSWORD_WALLET=aegis_secret
DBGATE_PASSWORD_REPORTING=aegis_secret
DBGATE_PASSWORD_AUDIT=aegis_secret
DBGATE_PASSWORD_FRAUD=aegis_secret
DBGATE_PASSWORD_PAYMENT=aegis_secret
