# ============================================================================
# Aegis — Environment Variables
# ============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit the .env file — it is already in .gitignore.
# ============================================================================

# ── PostgreSQL ──────────────────────────────────────────────
# Password for all PostgreSQL instances (identity, wallet, reporting, audit, fraud).
# Used as POSTGRES_PASSWORD in docker-compose.yml.
POSTGRES_PASSWORD=aegis_secret

# ── Spring Boot Datasource ──────────────────────────────────
# Password used by Spring Boot services to connect to PostgreSQL.
# Used as SPRING_DATASOURCE_PASSWORD in docker-compose.yml.
SPRING_DATASOURCE_PASSWORD=aegis_secret

# ── DbGate Admin UI ─────────────────────────────────────────
# Per-database passwords for the DbGate admin tool.
# Each database can have its own password; defaults match POSTGRES_PASSWORD.
DBGATE_PASSWORD_IDENTITY=aegis_secret
DBGATE_PASSWORD_WALLET=aegis_secret
DBGATE_PASSWORD_REPORTING=aegis_secret
DBGATE_PASSWORD_AUDIT=aegis_secret
DBGATE_PASSWORD_FRAUD=aegis_secret
