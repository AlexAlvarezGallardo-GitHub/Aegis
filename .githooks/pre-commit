#!/usr/bin/env bash
#
# pre-commit hook: validates branch naming convention
# Enable: git config core.hooksPath .githooks
#

BRANCH=$(git branch --show-current)

# Skip if on main or detached HEAD
if [ "$BRANCH" = "main" ] || [ -z "$BRANCH" ]; then
  exit 0
fi

TYPES="feature|fix|chore|refactor|docs|test|ci|security"
PATTERN="^($TYPES)/[0-9]+-[a-z0-9-]+$"

if ! echo "$BRANCH" | grep -qE "$PATTERN"; then
  echo ""
  echo "ERROR: Branch name '$BRANCH' does not follow convention."
  echo ""
  echo "  Expected: <type>/<number>-<short-description>"
  echo "  Types:    $TYPES"
  echo "  Rules:    lowercase kebab-case, no spaces or underscores"
  echo ""
  echo "  Examples:"
  echo "    feature/001-user-registration"
  echo "    fix/042-jwt-refresh-rotation"
  echo ""
  echo "  Rename with: git branch -m <new-name>"
  echo ""
  exit 1
fi
